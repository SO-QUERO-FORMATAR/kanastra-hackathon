{
  "name": "antecipe-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "generate:api": "openapi-typescript contracts/openapi.json -o src/api/schema.d.ts --default-non-nullable false",
    "test:e2e": "playwright test",
    "check:api": "node scripts/check-api.mjs",
    "format": "prettier --write src tests *.ts *.json *.html docs README.md scripts --ignore-path .prettierignore",
    "local:up": "node scripts/local-compose.mjs up",
    "local:down": "node scripts/local-compose.mjs down",
    "local:logs": "node scripts/local-compose.mjs logs",
    "local:status": "node scripts/local-compose.mjs status",
    "api:check": "node scripts/check-local-api.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@fontsource/syne": "^5.2.0",
    "@quasar/extras": "^1.16.0",
    "quasar": "^2.18.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@quasar/vite-plugin": "^1.10.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "openapi-typescript": "^7.9.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.93.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
